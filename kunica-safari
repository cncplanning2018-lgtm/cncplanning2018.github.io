<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Kunika Safari - Gaole</title>
    <script src="https://aframe.io/releases/1.4.0/aframe.min.js"></script>
    <script src="https://raw.githack.com/AR-js-org/AR.js/master/aframe/build/aframe-ar.js"></script>
    
    <style>
        /* ボタンのデザイン（ガオーレ専用：ゴールドグラデーション） */
        .ar-launch-button {
            position: fixed;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            padding: 18px 32px;
            background: linear-gradient(135deg, #d4af37 0%, #b8860b 100%);
            color: white;
            border-radius: 50px;
            display: none; /* マーカー検知まで非表示 */
            z-index: 9999;
            text-decoration: none;
            font-family: sans-serif;
            font-weight: bold;
            font-size: 1.1rem;
            box-shadow: 0 8px 15px rgba(0,0,0,0.4);
            border: 2px solid #fff;
            text-align: center;
            -webkit-tap-highlight-color: transparent;
        }

        #status-label {
            position: fixed;
            top: 20px;
            width: 100%;
            text-align: center;
            color: white;
            z-index: 10000;
            font-family: sans-serif;
            text-shadow: 2px 2px 4px #000;
            pointer-events: none;
        }
    </style>
</head>

<body style="margin: 0; overflow: hidden;">

    <div id="status-label">ガオーレのマーカーを映してください</div>

    <a id="ar-link" rel="ar" href="gaoreu.usdz" class="ar-launch-button">
        ガオーレを目の前に出す
    </a>

    <a-scene embedded arjs="sourceType: webcam; debugUIEnabled: false;">
        
        <a-marker id="gaole-marker" type="pattern" url="pattern-marker01.patt">
            <a-entity
                id="gaole-model"
                gltf-model="url(gaore.glb)"
                scale="0.5 0.5 0.5"
                position="0 0 0"
                rotation="0 0 0">
            </a-entity>
        </a-marker>

        <a-entity camera></a-entity>
    </a-scene>

    <script>
        const marker = document.querySelector('#gaole-marker');
        const btn = document.querySelector('#ar-link');
        const statusLabel = document.querySelector('#status-label');

        // マーカーを検知したとき
        marker.addEventListener('markerFound', () => {
            btn.style.display = 'block';
            statusLabel.style.display = 'none'; // 検知したら上の文字を消す
        });

        // マーカーを見失ったとき
        marker.addEventListener('markerLost', () => {
            // 体験をスムーズにするため、一度出たボタンはあえて消さない設定もアリです。
            // 厳密に制御したい場合は以下を有効にしてください。
            // btn.style.display = 'none';
            // statusLabel.style.display = 'block';
        });
    </script>
</body>
</html>




